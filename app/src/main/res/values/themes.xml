<resources>
    <!-- v3: dark theme in the DroidWeb palette (was the stock purple
         Material theme). No action bar — the layout draws its own header. -->
    <style name="Theme.DroidWeb" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dw_accent</item>
        <item name="colorPrimaryVariant">@color/dw_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/dw_accent</item>
        <item name="colorSecondaryVariant">@color/dw_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/dw_bg</item>
        <item name="android:textColorPrimary">@color/dw_text</item>
        <item name="android:textColorSecondary">@color/dw_muted</item>
    </style>
</resources>
